                                                        <subviews>
                                                            <textView editable="NO" importsGraphics="NO" verticallyResizable="YES" usesFontPanel="YES" findStyle="panel" continuousSpellChecking="YES" allowsUndo="YES" usesRuler="YES" allowsNonContiguousLayout="YES" quoteSubstitution="YES" dashSubstitution="YES" spellingCorrection="YES" smartInsertDelete="YES" id="Gfd-AM-hgX">
                                                                <rect key="frame" x="0.0" y="0.0" width="306" height="438"/>
                                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                                <color key="textColor" red="0.1529541016" green="0.1529541016" blue="0.1529541016" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                                <size key="minSize" width="306" height="438"/>
                                                                <size key="maxSize" width="463" height="10000000"/>
                                                                <attributedString key="textStorage">
                                                                    <fragment>
                                                                        <string key="content">DESFire cards use applications to organize information and are similar to a folder. A card can hold up to 28 applications. Each application is defined by a three byte application identifier (AID) and is linked to set of up to 14 different  access keys. The access keys are used with files to define access rights to these files.</string>
                                                                        <attributes>
                                                                            <color key="NSColor" red="0.1529541016" green="0.1529541016" blue="0.1529541016" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                                            <font key="NSFont" size="11" name="HelveticaNeue"/>
                                                                            <font key="NSOriginalFont" metaFont="smallSystem"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="natural" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment>
                                                                        <string key="content" base64-UTF8="YES">
Cg
</string>
                                                                        <attributes>
                                                                            <color key="NSColor" red="0.1529541016" green="0.1529541016" blue="0.1529541016" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                                            <font key="NSFont" size="11" name="HelveticaNeue"/>
                                                                            <real key="NSKern" value="0.0"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="natural" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0"/>
                                                                            <color key="NSStrokeColor" red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                                            <real key="NSStrokeWidth" value="0.0"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment>
                                                                        <string key="content" base64-UTF8="YES">
Cg
</string>
                                                                        <attributes>
                                                                            <color key="NSColor" red="0.1529541016" green="0.1529541016" blue="0.1529541016" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                                            <font key="NSFont" size="11" name="HelveticaNeue"/>
                                                                            <real key="NSKern" value="0.0"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="natural" lineBreakMode="wordWrapping" baseWritingDirection="leftToRight" defaultTabInterval="36" tighteningFactorForTruncation="0.0">
                                                                                <tabStops/>
                                                                            </paragraphStyle>
                                                                            <color key="NSStrokeColor" red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                                            <real key="NSStrokeWidth" value="0.0"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment content="The PICC master application has AID 000000 and only one key. This application can't be deleted and is created automatically.">
                                                                        <attributes>
                                                                            <color key="NSColor" red="0.1529541016" green="0.1529541016" blue="0.1529541016" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                                            <font key="NSFont" size="11" name="HelveticaNeue"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="natural" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment>
                                                                        <string key="content" base64-UTF8="YES">
Cg
</string>
                                                                        <attributes>
                                                                            <color key="NSColor" red="0.15295" green="0.15295" blue="0.15295" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                                            <font key="NSFont" size="11" name="HelveticaNeue"/>
                                                                            <real key="NSKern" value="0.0"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="natural" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0"/>
                                                                            <color key="NSStrokeColor" red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment>
                                                                        <string key="content" base64-UTF8="YES">
Cg
</string>
                                                                        <attributes>
                                                                            <color key="NSColor" red="0.15295" green="0.15295" blue="0.15295" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                                            <font key="NSFont" size="11" name="HelveticaNeue"/>
                                                                            <real key="NSKern" value="0.0"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="left" lineBreakMode="wordWrapping" baseWritingDirection="leftToRight" defaultTabInterval="36" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO">
                                                                                <tabStops/>
                                                                            </paragraphStyle>
                                                                            <color key="NSStrokeColor" red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment>
                                                                        <string key="content">You have to create an application first before you can store files in that application. With this operation you define the maximum number of keys that can be used for this application. </string>
                                                                        <attributes>
                                                                            <color key="NSColor" red="0.1529541016" green="0.1529541016" blue="0.1529541016" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                                            <font key="NSFont" size="11" name="HelveticaNeue"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="natural" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment>
                                                                        <string key="content" base64-UTF8="YES">
Cg
</string>
                                                                        <attributes>
                                                                            <color key="NSColor" red="0.15295" green="0.15295" blue="0.15295" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                                            <font key="NSFont" size="11" name="HelveticaNeue"/>
                                                                            <real key="NSKern" value="0.0"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="natural" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0"/>
                                                                            <color key="NSStrokeColor" red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment>
                                                                        <string key="content" base64-UTF8="YES">
Cg
</string>
                                                                        <attributes>
                                                                            <color key="NSColor" red="0.15295" green="0.15295" blue="0.15295" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                                            <font key="NSFont" size="11" name="HelveticaNeue"/>
                                                                            <real key="NSKern" value="0.0"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="natural" lineBreakMode="wordWrapping" baseWritingDirection="leftToRight" defaultTabInterval="36" tighteningFactorForTruncation="0.0">
                                                                                <tabStops/>
                                                                            </paragraphStyle>
                                                                            <color key="NSStrokeColor" red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment content="Once an application is created, ">
                                                                        <attributes>
                                                                            <color key="NSColor" red="0.1529541016" green="0.1529541016" blue="0.1529541016" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                                            <font key="NSFont" size="11" name="HelveticaNeue"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="natural" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment content="all key for an application are &quot;00...0&quot;. ">
                                                                        <attributes>
                                                                            <color key="NSColor" red="0.15295" green="0.15295" blue="0.15295" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                                            <font key="NSFont" size="11" name="HelveticaNeue"/>
                                                                            <real key="NSKern" value="0.0"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="natural" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0"/>
                                                                            <color key="NSStrokeColor" red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment content="you should change all keys for that application in a next step.">
                                                                        <attributes>
                                                                            <color key="NSColor" red="0.1529541016" green="0.1529541016" blue="0.1529541016" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                                            <font key="NSFont" size="11" name="HelveticaNeue"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="natural" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment>
                                                                        <string key="content" base64-UTF8="YES">
Cg
</string>
                                                                        <attributes>
                                                                            <color key="NSColor" red="0.15295" green="0.15295" blue="0.15295" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                                            <font key="NSFont" size="11" name="HelveticaNeue"/>
                                                                            <real key="NSKern" value="0.0"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="natural" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment>
                                                                        <string key="content" base64-UTF8="YES">
Cg
</string>
                                                                        <attributes>
                                                                            <color key="NSColor" red="0.15295" green="0.15295" blue="0.15295" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                                            <font key="NSFont" size="11" name="HelveticaNeue"/>
                                                                            <real key="NSKern" value="0.0"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="left" lineBreakMode="wordWrapping" baseWritingDirection="leftToRight" defaultTabInterval="36" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO">
                                                                                <tabStops/>
                                                                            </paragraphStyle>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment>
                                                                        <string key="content">The application master key for each application is defined by the AID and key number 0.   Delete function allows to deactivate an application on the card. If setting for authentication with application master key is actvated that key needs to be used to delete the application. Otherwise the PICC master application key needs to be used.</string>
                                                                        <attributes>
