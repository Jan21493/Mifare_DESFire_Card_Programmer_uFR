                                                                <size key="minSize" width="320" height="438"/>
                                                                <size key="maxSize" width="463" height="10000000"/>
                                                                <attributedString key="textStorage">
                                                                    <fragment>
                                                                        <mutableString key="content">This section contains all internal operations between this application on a PC/Mac and the uFR card reader that do not require a Mifare DESFire card..   You can store up to 16 128-Bit AES keys in the non-volatile internal key memory storage of the reader.  It is a good idea to use this feature for security purpose. The keys can't be read out from the reader and don't have to be coded in the application itself anymore. You only use a reference to a specific internal key number for all operations that require AES keys for authentication.  Access to the internal keys for operations can be protected by a password. </mutableString>
                                                                        <attributes>
                                                                            <color key="NSColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                                                            <font key="NSFont" metaFont="controlContent" size="11"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="natural" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                </attributedString>
                                                                <color key="insertionPointColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                            </textView>
                                                        </subviews>
