                                                <scrollView autohidesScrollers="YES" horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" hasHorizontalScroller="NO" usesPredominantAxisScrolling="NO" translatesAutoresizingMaskIntoConstraints="NO" id="pMv-wH-ohU">
                                                    <rect key="frame" x="636" y="124" width="322" height="440"/>
                                                    <clipView key="contentView" drawsBackground="NO" id="4b6-6E-EjL">
                                                        <rect key="frame" x="1" y="1" width="320" height="438"/>
                                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                        <subviews>
                                                            <textView editable="NO" importsGraphics="NO" verticallyResizable="YES" usesFontPanel="YES" findStyle="panel" continuousSpellChecking="YES" allowsUndo="YES" usesRuler="YES" allowsNonContiguousLayout="YES" quoteSubstitution="YES" dashSubstitution="YES" spellingCorrection="YES" smartInsertDelete="YES" id="2HQ-Y1-NRm">
                                                                <rect key="frame" x="0.0" y="0.0" width="320" height="438"/>
                                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                                <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                                <size key="minSize" width="320" height="438"/>
                                                                <size key="maxSize" width="463" height="10000000"/>
                                                                <attributedString key="textStorage">
                                                                    <fragment>
                                                                        <mutableString key="content">DESFire cards use files to store information. Files have a specified type (currently data only) and need to be created first. During creation time a fixed size, the communication mode and keys to access the data need to be specified. Communication mode can be plain, MAC hashed, or enciphered.   The application keys for reading data, writing data or both and change access rights can be choosen from 0 (application master key) up to the number that used when the application was created (minus 1). Key numbers are counted from 0 to x and are specific for each application.</mutableString>
                                                                        <attributes>
                                                                            <color key="NSColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                                                            <font key="NSFont" metaFont="controlContent" size="11"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="natural" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment>
                                                                        <mutableString key="content">  Changing access rights is only available for EV3 cards. Access rights can only be set at creation time for EV1 and EV2 cards.   If no authentication is allowed for an application, that option can be used. Otherwise the master key of the specific application (key 0).   If a file is deleted, the space is returned to the free memory of that card.</mutableString>
                                                                        <attributes>
                                                                            <color key="NSColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                                                            <font key="NSFont" size="11" name="HelveticaNeue"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="natural" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                </attributedString>
                                                                <color key="insertionPointColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                            </textView>
                                                        </subviews>
                                                    </clipView>
