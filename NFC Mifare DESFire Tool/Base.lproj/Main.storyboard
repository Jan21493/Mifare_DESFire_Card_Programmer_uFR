                                                        <autoresizingMask key="autoresizingMask"/>
                                                        <subviews>
                                                            <textView editable="NO" importsGraphics="NO" verticallyResizable="YES" usesFontPanel="YES" findStyle="panel" continuousSpellChecking="YES" allowsUndo="YES" usesRuler="YES" allowsNonContiguousLayout="YES" quoteSubstitution="YES" dashSubstitution="YES" spellingCorrection="YES" smartInsertDelete="YES" id="wfl-Vk-Rx0">
                                                                <rect key="frame" x="0.0" y="0.0" width="306" height="438"/>
                                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                                <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                                <size key="minSize" width="306" height="438"/>
                                                                <size key="maxSize" width="463" height="10000000"/>
                                                                <attributedString key="textStorage">
                                                                    <fragment>
                                                                        <mutableString key="content">This section contains general operations you can do on DESFire cards.  For security purpose it is recommended to protect each card by changing the PICC (card) master key (AID=000000), app key=0 to a new value. This will prevent unauthorized formatting of the card. It is recommended to convert the crypto algorithm on each card from DES/3DES to AES first, because only AES is implemented in hardware on the reader. You may also protect the real UID on the card by converting the card to random UID mode. In this case you need the card master key or a valid application key with read access rights to read the real UID from the card.  ATTENTION: You cannot revert the crypto algorithm back to DES/3DES on a card. You can also not switch back to the real UID mode once a card is converted to random UID mode.  Be also careful with the disable formatting option, because it can't be reverted either.  Authentication is required for formatting of a card, modify settings and to get the real UID.  The real UID can be retrieved with any of the applications and one of its keys that is stored on a card. The key needs to have read access rights to get the real UID. </mutableString>
                                                                        <attributes>
                                                                            <color key="NSColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                                                            <font key="NSFont" size="11" name="HelveticaNeue"/>
                                                                            <paragraphStyle key="NSParagraphStyle" alignment="left" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                </attributedString>
                                                                <color key="insertionPointColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                            </textView>
                                                        </subviews>
                                                    </clipView>
